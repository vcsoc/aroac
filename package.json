{
  "name": "oar",
  "version": "0.3.12",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "node scripts/build-licenses.js && vite build && node scripts/build-local-service.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "desktop:dev": "npm run build && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node desktop/dev.cjs\"",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --publish never",
    "mobile:sync": "npm run build && cap sync ios",
    "ios": "cap open ios",
    "test:desktop": "node tests/desktop-smoke.js",
    "test:guidance": "node tests/guidance-smoke.js",
    "test:release-ten": "node tests/release-ten-smoke.js",
    "test:browser": "playwright test",
    "desktop:local": "node scripts/desktop-local.js",
    "test:maps": "node tests/map-interactions.js",
    "test:workspace": "node tests/workspace-smoke.js",
    "test:locations": "node tests/location-controls-smoke.js",
    "test:display": "node tests/display-smoke.js",
    "test:contacts": "node tests/contact-navigation-smoke.js",
    "test:layout": "node tests/layout-settings-smoke.js",
    "test:quick": "node tests/quick-login-smoke.js",
    "test:panels": "node tests/panel-layout-smoke.js",
    "test:items": "node tests/saved-items-smoke.js",
    "test:account": "node tests/account-smoke.js",
    "test:seven": "node tests/release-seven-smoke.js"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@rapideditor/country-coder": "^5.6.1",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.13",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "suncalc": "^1.9.0",
    "tz-lookup": "^6.1.25",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.7",
    "vite": "^7.1.0",
    "wait-on": "^9.1.0"
  },
  "main": "desktop/main.cjs",
  "description": "OAR desktop and mobile amateur radio workspace",
  "author": "OAR Contributors",
  "desktopName": "org.openamateurradio.oar.desktop"
}
